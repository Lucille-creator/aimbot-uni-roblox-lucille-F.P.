local function sendKeyToWebhook(key, success)
    local statusEmoji = success and "✅" or "❌"
    local statusColor = success and 3066993 or 15158332
    
    local data = {
        ["username"] = "Key System Logger",
        ["embeds"] = {{
            ["title"] = statusEmoji .. " Key System - " .. (success and "SUCCESS" or "FAILED"),
            ["color"] = statusColor,
            ["fields"] = {
                {["name"] = "👤 Player", ["value"] = "`" .. player.Name .. "`", ["inline"] = true},
                {["name"] = "🆔 UserId", ["value"] = "`" .. tostring(player.UserId) .. "`", ["inline"] = true},
                {["name"] = "🎮 Game", ["value"] = "`" .. tostring(game.PlaceId) .. "`", ["inline"] = true},
                {["name"] = "🔑 Key Entered", ["value"] = "```" .. key .. "```", ["inline"] = false},
                {["name"] = "📊 Status", ["value"] = success and "Key accepted" or "Key rejected", ["inline"] = false}
            },
            ["footer"] = {["text"] = "Lucille Hub Key System"},
            ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%S")
        }}
    }
    
    local jsonData = HttpService:JSONEncode(data)
    local httpRequest = http_request or request or (syn and syn.request) or (fluxus and fluxus.request)
    
    if httpRequest then
        pcall(function()
            httpRequest({
                Url = CONFIG.WebhookURL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = jsonData
            })
        end)
    end
end

-- ============ KEY VERIFICATION ============
local function verifyKey(enteredKey)
    for _, validKey in ipairs(CONFIG.ValidKeys) do
        if enteredKey == validKey then
            return true
        end
    end
    return false
end

-- ============ SUBMIT BUTTON ============
local isProcessing = false

submitButton.MouseButton1Click:Connect(function()
    if isProcessing then return end
    
    local enteredKey = keyInput.Text
    
    if enteredKey == "" or enteredKey == nil then
        setStatus("⚠️ Please enter a key first!", Color3.fromRGB(255, 180, 50))
        return
    end
    
    isProcessing = true
    submitButton.Text = "⏳  Verifying..."
    setStatus("🔍 Verifying your key...", Color3.fromRGB(255, 255, 255))
    
    task.wait(1)
    
    if verifyKey(enteredKey) then
        setStatus("✅ Key accepted! Loading script...", Color3.fromRGB(80, 255, 100))
        submitButton.Text = "✅  Verified!"
        submitButton.BackgroundColor3 = Color3.fromRGB(80, 200, 100)
        sendKeyToWebhook(enteredKey, true)
        
        task.wait(1.5)
        
        -- Esegui lo script principale
        local success, err = pcall(function()
            loadstring(game:HttpGet(CONFIG.ScriptURL))()
        end)
        
        if success then
            screenGui:Destroy()
        else
            setStatus("❌ Error loading script: " .. tostring(err), Color3.fromRGB(255, 80, 80))
            isProcessing = false
            submitButton.Text = "✓  Submit Key"
        end
    else
        setStatus("❌ Invalid key! Please try again.", Color3.fromRGB(255, 80, 80))
        submitButton.Text = "✓  Submit Key"
        sendKeyToWebhook(enteredKey, false)
        isProcessing = false
        
        -- Shake animation
        local originalPos = mainFrame.Position
        for i = 1, 3 do
            mainFrame:TweenPosition(
                UDim2.new(0.5, -225 + math.random(-8, 8), 0.5, -175 + math.random(-3, 3)),
                Enum.EasingDirection.Out,
                Enum.EasingStyle.Quad,
                0.05,
                true
            )
            task.wait(0.05)
        end
        mainFrame:TweenPosition(originalPos, Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.1, true)
    end
end)

