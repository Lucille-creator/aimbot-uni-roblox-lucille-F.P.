-- Ottiene un ID unico del PC
local function getHWID()
    if not config.enableHWID then return "off" end
    local success, result = pcall(function()
        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)
    if success and result ~= "" then
        return HttpService:MD5(result)
    end
    return HttpService:MD5(tostring(player.UserId))
end

-- Invia log su Discord
local function sendLog(type, key)
    if not config.enableDiscordLog or config.webhookUrl == "" then return end
    
    local embed = {
        ["embeds"] = {{
            ["title"] = "🔑 Accesso Key System",
            ["color"] = type == "success" and 3066993 or 15158332,
            ["fields"] = {
                {["name"] = "👤 Utente", ["value"] = player.Name, ["inline"] = true},
                {["name"] = "✅ Stato", ["value"] = type == "success" and "Successo" or "Negato", ["inline"] = true},
                {["name"] = "🔑 Key", ["value"] = "||" .. key .. "||", ["inline"] = false},
                {["name"] = "💻 HWID", ["value"] = "||" .. hwid .. "||", ["inline"] = false},
                {["name"] = "📅 Data", ["value"] = os.date("%d/%m/%Y %H:%M:%S"), ["inline"] = false}
            }
        }}
    }
    
    pcall(function()
        syn.request({
            Url = config.webhookUrl,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(embed)
        })
    end)
end

-- Verifica la key
local function verifyKey(key)
    key = key:upper():gsub("%s+", "")
    hwid = getHWID()
    
    if config.keys[key] then
        sendLog("success", key)
        return true
    end
    
    sendLog("denied", key)
    return false
end

